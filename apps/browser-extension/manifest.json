{
  "manifest_version": 3,
  "name": "AIO Browser Capture",
  "description": "Runtime foundation for browser-tab capture into Universal Capture Snapshot.",
  "version": "0.1.0",
  "permissions": ["activeTab", "tabs", "storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "dist/src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/src/content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AIO Browser Capture",
    "default_popup": "popup.html"
  }
}
